# ===========================================
# Remote Days - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/dbname
# Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://admin:password@localhost:5432/tracker

# Legacy database credentials (used by docker-compose)
DB_USER=admin
DB_PASS=password
DB_NAME=tracker

# ===========================================
# Authentication
# ===========================================
# JWT secret key - MUST be at least 32 characters in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars

# JWT token expiration (default: 1d)
JWT_EXPIRATION=1d

# ===========================================
# Server Configuration
# ===========================================
# Server port (default: 3000)
PORT=3000

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Environment: development | production | test
NODE_ENV=development

# ===========================================
# Application URLs
# ===========================================
# Frontend URL (for CORS and email links)
APP_URL=http://localhost:5173

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# SMTP server host
SMTP_HOST=smtp.example.com

# SMTP server port (default: 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Use secure connection (true for port 465)
SMTP_SECURE=false

# Email sender address
EMAIL_FROM=noreply@remotedays.app

# Address outbound mail is sent *from*. The SMTP relay only accepts a sender it
# has verified, so keep this a no-reply address and use LEAD_NOTIFICATION_EMAIL
# below for anything a human has to actually read.
SMTP_FROM="Remote Days" <noreply@remotedays.app>

# Where landing-page contact requests are delivered
# (default: hello@remotedays.app). Separate from SMTP_FROM on purpose.
LEAD_NOTIFICATION_EMAIL=hello@remotedays.app

# Daily Email Limit (for testing/quota management) - default: Infinity
# DAILY_EMAIL_LIMIT=5

# ===========================================
# Business Rules
# ===========================================
# Maximum remote work days per year (default: 34 for France)
MAX_HOME_DAYS=34

# ===========================================
# Nightly demo-data reset
# ===========================================
# WARNING: when enabled, a cron job TRUNCATES and regenerates ALL demo data
# every night. Leave it off in production unless this is a demo environment.
# Default: true in development, false in production.
# DEMO_SEED_ENABLED=true

# Cron expression for the reset. Default: every day at 00:00.
# DEMO_SEED_CRON=0 0 * * *

# IANA timezone the cron expression is interpreted in.
# Default: Europe/Paris (CET/CEST).
# DEMO_SEED_TIMEZONE=Europe/Paris

# Fix the seeder's PRNG so every run produces identical demo data.
# Unset by default (a stable built-in seed is used).
# DEMO_SEED_RANDOM_SEED=20260101

# ===========================================
# Enterprise SSO (OIDC)
# ===========================================
# SSO itself is configured by an admin in the app (Admin -> Single Sign-On)
# and stored in the database, so it needs no environment variables.
#
# However the API must know its own public URL to build the OIDC redirect_uri.
# This must match the app registration exactly and point at the API origin
# (that is where the session cookie is set) — not at the web app.
# Example: https://api.remotedays.app
API_PUBLIC_URL=http://localhost:3000

# Registered redirect URI to add to your identity provider's app registration:
#   {API_PUBLIC_URL}/v1/auth/sso/callback
